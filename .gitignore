# ========================================
# .gitignore - Minecraft-Italia Auto-Vote
# ========================================

# Sicurezza & credenziali
.env
.env.*
!.env.example
cookies.json
*.pem
*.key
*.crt
*.csr
*.p12
*.jks

# Dipendenze Node.js
node_modules/
.pnp.*
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Output di build / artefatti temporanei
dist/
build/
out/
coverage/
.nyc_output/
*.tsbuildinfo
*.tgz
*.seed
*.pid
*.pid.lock

# Cache e file temporanei
.cache/
.cache
.tmp/
tmp/
temp/
.npm/
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache/
.vite/
.next/
.nuxt/
.svelte-kit/
serverless/
.terraform/

# Log e debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor e IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iml
*.log
*.gz
*.zip

# Sistema operativo e files di sistema
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
Icon?

# Altri file comuni da ignorare
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.orig
*.rej
*.bak
*.tmp
*.tmp.*
*~

# Specifiche del progetto
api/
Docs/*
!CHANGELOG.md